<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ProbbyApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#245AC5</item>
        <item name="colorPrimaryVariant">#373738</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#454242</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#245AC5</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Base.Theme.ProbbyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="background">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryVariant">#373738</item>
        <item name="rippleColor">@color/ripple_white</item>
        <item name="android:windowSplashScreenBackground">@color/white</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#454242</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#245AC5</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="android:textColor">#000000</item>
    </style>
</resources>
